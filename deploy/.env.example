# deploy/.env: settings and secrets for the production-like stack (deploy/docker-compose.yml).
# Copy this file to deploy/.env (git-ignored) and change every password and token.
# Passwords end up in connection URLs: use letters, digits, '-' and '_' only.

# Postgres superuser (only the postgres container uses it).
POSTGRES_PASSWORD=postgres_dev_pw
# Roles created by deploy/postgres/init.sql when the data volume is first created. Changing them
# later needs ALTER ROLE ... PASSWORD in the database too (or a fresh volume).
APP_DB_PASSWORD=app_dev_pw
OWNER_DB_PASSWORD=owner_dev_pw
# PgBouncer's read-only console user `travelmind_stats` (SHOW POOLS / SHOW STATS). It exists only
# in PgBouncer, not in Postgres; changing it takes effect when the pgbouncer container restarts.
PGBOUNCER_STATS_PASSWORD=pgbouncer_stats_dev_pw

# Postgres memory (empty = 256MB and 8MB). work_mem is per sort or hash step, per connection.
PG_SHARED_BUFFERS=
PG_WORK_MEM=

# Bearer token for GET /metrics inside the compose network (api:8000/metrics). nginx never
# serves /metrics. Empty: /metrics is off in production.
TM_METRICS_TOKEN=change-me-metrics-token

# Scaling: API containers and gunicorn workers per container (empty = min(2 x CPUs + 1, 8)).
API_REPLICAS=2
WEB_CONCURRENCY=

# Sandbox supplier (demo flights): on, because this local stack has no real supplier keys.
TM_SANDBOX_SUPPLIER=true

# Real supplier keys (optional; leave empty for the sandbox only).
TM_DUFFEL_TOKEN=
TM_LITEAPI_KEY=
TM_GOOGLE_TIM_API_KEY=
TM_TRAVELPAYOUTS_TOKEN=
TM_FX_ENABLED=true

TM_LOG_LEVEL=INFO
