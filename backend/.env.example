TM_ENVIRONMENT=development
TM_DATABASE_URL=postgresql+asyncpg://travelmind_app:app_dev_pw@localhost:5433/travelmind
TM_MIGRATION_DATABASE_URL=postgresql+asyncpg://travelmind_owner:owner_dev_pw@localhost:5433/travelmind
TM_REDIS_URL=redis://localhost:6380/0
TM_ALLOWED_ORIGINS=["http://localhost:5173"]
TM_COOKIE_SECURE=false
TM_LOG_LEVEL=INFO

# Rate limits (defaults shown)
TM_LOGIN_MAX_ATTEMPTS=10
TM_LOGIN_IP_MAX_ATTEMPTS=50
TM_LOGIN_WINDOW_SECONDS=900
TM_SIGNUP_MAX_PER_IP=10
TM_SIGNUP_WINDOW_SECONDS=3600

# Suppliers (leave empty until you have keys; see docs/research/2026-09-29-supplier-apis.md)
# Without keys the sandbox supplier serves demo flights.
# duffel_test_… from the Duffel dashboard (test mode is free)
TM_DUFFEL_TOKEN=
# sand_… from the LiteAPI dashboard
TM_LITEAPI_KEY=
# Google Cloud API key with the Travel Impact Model API enabled
TM_GOOGLE_TIM_API_KEY=
# Travelpayouts Data API token (seeds fare history)
TM_TRAVELPAYOUTS_TOKEN=
# Sandbox test inventory: empty = on in development, off in production
TM_SANDBOX_SUPPLIER=
# ECB reference rates for "≈" converted prices
TM_FX_ENABLED=true

# Agent places and weather (OpenStreetMap Nominatim + Overpass need no key; nor does Open-Meteo
# outside production).
# A URL or email identifying whoever runs this deployment, sent in the User-Agent to
# OpenStreetMap services as their usage policies ask. Leave empty in the repo.
TM_OSM_CONTACT=
# Optional: OpenTripMap key; when set, find_places uses OpenTripMap instead of Overpass
TM_OPENTRIPMAP_KEY=
# Open-Meteo API key (paid plan). The free API is for non-commercial use only: in production,
# weather_forecast is unavailable without a key (startup logs a warning). With a key, calls go
# to the customer hosts (customer-api.open-meteo.com, customer-archive-api.open-meteo.com;
# "typical" weather uses the historical API, which needs the Professional plan or higher).
TM_OPEN_METEO_API_KEY=
