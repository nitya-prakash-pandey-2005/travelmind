TM_ENVIRONMENT=development
TM_DATABASE_URL=postgresql+asyncpg://travelmind_app:app_dev_pw@localhost:5433/travelmind
TM_MIGRATION_DATABASE_URL=postgresql+asyncpg://travelmind_owner:owner_dev_pw@localhost:5433/travelmind
TM_REDIS_URL=redis://localhost:6380/0
TM_ALLOWED_ORIGINS=["http://localhost:5173"]
TM_COOKIE_SECURE=false
TM_LOG_LEVEL=INFO

# Rate limits (defaults shown)
TM_LOGIN_MAX_ATTEMPTS=10
TM_LOGIN_IP_MAX_ATTEMPTS=50
TM_LOGIN_WINDOW_SECONDS=900
TM_SIGNUP_MAX_PER_IP=10
TM_SIGNUP_WINDOW_SECONDS=3600

# Suppliers (leave empty until you have keys; see docs/research/2026-09-29-supplier-apis.md)
TM_DUFFEL_TOKEN=
TM_LITEAPI_KEY=
TM_GOOGLE_TIM_API_KEY=
TM_TRAVELPAYOUTS_TOKEN=
# Sandbox test inventory: empty = on in development, off in production
TM_SANDBOX_SUPPLIER=
TM_FX_ENABLED=true
